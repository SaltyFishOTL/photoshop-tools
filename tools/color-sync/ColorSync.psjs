// Color Sync 0.7.1 — local colour offsets with detail preservation
try{await(async()=>{const engine=(()=>{
// Fit corresponding smooth colour regions. Never warp or resample target geometry.
'use strict';
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const distance=(a,b)=>(a[0]-b[0])**2+(a[1]-b[1])**2+(a[2]-b[2])**2;
function bounds(im){const {data:d,width:w,height:h}=im;let l=w,t=h,r=-1,b=-1;for(let y=0;y<h;y+=2)for(let x=0;x<w;x+=2){const i=(y*w+x)*4;if(d[i+3]<200||Math.min(d[i],d[i+1],d[i+2])>240)continue;l=Math.min(l,x);r=Math.max(r,x);t=Math.min(t,y);b=Math.max(b,y);}if(r-l<8||b-t<8)throw Error('没有足够的人物像素');return {l,t,w:r-l+1,h:b-t+1};}
function samples(im,b){const out=[],{width:w,height:h,data:d}=im,step=Math.max(2,Math.ceil(Math.sqrt(w*h/80000)));for(let y=2;y<h-2;y+=step)for(let x=2;x<w-2;x+=step){const i=(y*w+x)*4,c=[d[i],d[i+1],d[i+2]];if(d[i+3]<250||Math.max(...c)<38||Math.min(...c)>238)continue;let edge=0;for(const j of [i-4,i+4,i-w*4,i+w*4]){if(d[j+3]<250){edge=255;break;}for(let k=0;k<3;k++)edge=Math.max(edge,Math.abs(c[k]-d[j+k]));}if(edge>8)continue;out.push({c,x:clamp((x-b.l)/b.w,0,1),y:clamp((y-b.t)/b.h,0,1)});}return out;}
function nearest(c,p){let j=0,best=Infinity;for(let k=0;k<p.length;k++){const d=distance(c,p[k]);if(d<best){best=d;j=k;}}return j;}
function palette(points){const bins=new Map();for(const p of points){const key=p.c.map(x=>x>>3).join(',');let b=bins.get(key);if(!b){b={n:0,c:[0,0,0]};bins.set(key,b);}b.n++;for(let k=0;k<3;k++)b.c[k]+=p.c[k];}const ranked=[...bins.values()].sort((a,b)=>b.n-a.n),centers=[];for(const b of ranked){if(b.n<8)continue;const c=b.c.map(v=>v/b.n);if(centers.every(v=>distance(c,v)>28*28)){centers.push(c);if(centers.length===32)break;}}if(!centers.length)throw Error('可匹配的平滑色块不足');for(let pass=0;pass<5;pass++){const sums=centers.map(()=>[0,0,0,0]);for(const p of points){const j=nearest(p.c,centers);if(distance(p.c,centers[j])>48*48)continue;const s=sums[j];s[3]++;for(let k=0;k<3;k++)s[k]+=p.c[k];}for(let j=0;j<centers.length;j++)if(sums[j][3])centers[j]=sums[j].slice(0,3).map(v=>v/sums[j][3]);}return centers;}
function basis(x,y){return [1,x,y,x*x,x*y,y*y];}
function solve(a,b){const n=b.length,m=a.map((r,i)=>[...r,b[i]]);for(let i=0;i<n;i++){let p=i;for(let j=i+1;j<n;j++)if(Math.abs(m[j][i])>Math.abs(m[p][i]))p=j;[m[i],m[p]]=[m[p],m[i]];if(Math.abs(m[i][i])<1e-10)return null;const v=m[i][i];for(let k=i;k<=n;k++)m[i][k]/=v;for(let j=0;j<n;j++)if(j!==i){const f=m[j][i];for(let k=i;k<=n;k++)m[j][k]-=f*m[i][k];}}return m.map(r=>r[n]);}
function value(model,x,y){const f=basis(x,y);return model.map(a=>a.reduce((s,v,k)=>s+v*(f[k]||0),0));}
// Only spatial offsets are fitted. RGB-dependent slopes can erase reflections.
function fit(points){if(points.length<12)return null;let model;for(let pass=0;pass<3;pass++){const a=Array.from({length:6},()=>Array(6).fill(0)),v=Array.from({length:3},()=>Array(6).fill(0));for(const p of points){let weight=1;if(model){const residual=Math.sqrt(distance(p.c,value(model,p.x,p.y)));weight=Math.min(1,3/Math.max(1,residual));}const f=basis(p.x,p.y);for(let i=0;i<6;i++){for(let j=0;j<6;j++)a[i][j]+=weight*f[i]*f[j];for(let k=0;k<3;k++)v[k][i]+=weight*f[i]*p.c[k];}}for(let i=0;i<6;i++)a[i][i]+=i===0?1e-7:points.length*(i<3?.00003:.0003);model=v.map(c=>solve(a,c));if(model.some(x=>!x))return null;}return model;}
function prepare(ref){const b=bounds(ref),points=samples(ref,b);if(points.length<100)throw Error('参考层可匹配的平滑色块不足');const grid=64,bins=Array.from({length:grid*grid},()=>[]);for(const p of points)bins[Math.min(grid-1,Math.floor(p.y*grid))*grid+Math.min(grid-1,Math.floor(p.x*grid))].push(p);return {bounds:b,points,grid,bins};}
function match(reference,p){const g=reference.grid,cx=Math.min(g-1,Math.floor(p.x*g)),cy=Math.min(g-1,Math.floor(p.y*g));let best=null,cost=Infinity;for(let y=Math.max(0,cy-2);y<=Math.min(g-1,cy+2);y++)for(let x=Math.max(0,cx-2);x<=Math.min(g-1,cx+2);x++)for(const q of reference.bins[y*g+x]){const d=distance(p.c,q.c);if(d>64*64)continue;const spatial=(p.x-q.x)**2+(p.y-q.y)**2;if(spatial>.035**2)continue;const score=spatial*4/(.025**2)+d/(48*48);if(score<cost){cost=score;best=q;}}return best;}
// Blend neighbouring colour fits at palette boundaries to avoid gradient bands.
function correction(fields,k,a,fx,fy,g){const f=fields[k];let delta=(f[a]*(1-fx)+f[a+3]*fx)*(1-fy)+(f[a+g*3]*(1-fx)+f[a+g*3+3]*fx)*fy;return clamp(delta,-40,40);}
// Refine broad gradients locally so opposite sleeves cannot cancel each other.
function localValue(points,model,x,y){
 const base=value(model,x,y),near=[];let total=0;
 for(const p of points){const r=(p.x-x)**2+(p.y-y)**2;if(r>.075**2)continue;const w=Math.exp(-r/(2*.028**2));near.push({p,w});total+=w;}
 if(total<3)return base;
 let estimate=base;
 for(let pass=0;pass<4;pass++){const sums=[0,0,0];let weights=0;for(const {p,w} of near){const residual=Math.sqrt(distance(p.c,estimate)),weight=w*Math.min(1,2/Math.max(1,residual));weights+=weight;for(let ch=0;ch<3;ch++)sums[ch]+=p.c[ch]*weight;}estimate=sums.map(v=>v/weights);}
 const mix=clamp((total-3)/9,0,1);return estimate.map((v,ch)=>v*mix+base[ch]*(1-mix));
}
// Smooth the correction, never the image. Near-black lines and white/transparent
// pixels are excluded from both averaging and writes. Colour-distance weighting
// limits mixing between different materials; it is not semantic segmentation.
async function smoothCorrection(out, original, width, height, tick) {
 const count = width * height;
 const horizontal = new Float32Array(count * 3);
 const eligible = new Uint8Array(count);
 const radius = clamp(Math.round(Math.max(width, height) / 170), 2, 12);
 const weights = Array.from({length: radius + 1}, (_,x) => Math.exp(-2*x*x/(radius*radius)));
 for (let p = 0; p < count; p++) {
  const i = p * 4;
  eligible[p] = original[i+3] && Math.max(original[i],original[i+1],original[i+2]) >= 32
   && Math.min(original[i],original[i+1],original[i+2]) <= 238 ? 1 : 0;
 }
 for (let y = 0; y < height; y++) {
  if (y % 32 === 0) await tick(.65 + .15 * y / height);
  for (let x = 0; x < width; x++) {
   const p = y * width + x, i = p * 4;
   if (!eligible[p]) continue;
   let sum=0, red=0, green=0, blue=0;
   for (let dx = -radius; dx <= radius; dx++) {
    const xx = x + dx, q = p + dx, j = q * 4;
    if (xx < 0 || xx >= width || !eligible[q]) continue;
    const dist = (original[i]-original[j])**2 + (original[i+1]-original[j+1])**2 + (original[i+2]-original[j+2])**2;
    if (dist > 64*64) continue;
    const weight = weights[Math.abs(dx)] / (1 + dist / (48*48));
    sum += weight;
    red += (out[j]-original[j]) * weight;
    green += (out[j+1]-original[j+1]) * weight;
    blue += (out[j+2]-original[j+2]) * weight;
   }
   horizontal[p*3] = red/sum;
   horizontal[p*3+1] = green/sum;
   horizontal[p*3+2] = blue/sum;
  }
 }
 let changed = 0;
 for (let y = 0; y < height; y++) {
  if (y % 32 === 0) await tick(.8 + .2 * y / height);
  for (let x = 0; x < width; x++) {
   const p = y * width + x, i = p * 4;
   if (!eligible[p]) continue;
   let sum=0, red=0, green=0, blue=0;
   for (let dy = -radius; dy <= radius; dy++) {
    const yy = y + dy, q = p + dy * width, j = q * 4;
    if (yy < 0 || yy >= height || !eligible[q]) continue;
    const dist = (original[i]-original[j])**2 + (original[i+1]-original[j+1])**2 + (original[i+2]-original[j+2])**2;
    if (dist > 64*64) continue;
    const weight = weights[Math.abs(dy)] / (1 + dist / (48*48));
    sum += weight;
    red += horizontal[q*3] * weight;
    green += horizontal[q*3+1] * weight;
    blue += horizontal[q*3+2] * weight;
   }
   out[i] = clamp(Math.round(original[i] + red/sum), 0, 255);
   out[i+1] = clamp(Math.round(original[i+1] + green/sum), 0, 255);
   out[i+2] = clamp(Math.round(original[i+2] + blue/sum), 0, 255);
   if (out[i] !== original[i] || out[i+1] !== original[i+1] || out[i+2] !== original[i+2]) changed++;
  }
 }
 return changed;
}
async function synchronize(reference,target,tick=async()=>{}){
 const b=bounds(target),pts=samples(target,b);if(pts.length<100)throw Error('目标层可匹配的平滑色块不足');
 const centers=palette(pts),groups=centers.map(()=>[]),supports=centers.map(()=>({l:1,t:1,r:0,b:0}));
 for(let i=0;i<pts.length;i++){if(i%256===0)await tick(.25*i/pts.length);const p=pts[i],q=match(reference,p);if(!q)continue;const k=nearest(p.c,centers);if(distance(p.c,centers[k])>40*40)continue;groups[k].push({x:p.x,y:p.y,c:q.c.map((v,c)=>v-p.c[c])});const s=supports[k];s.l=Math.min(s.l,p.x);s.r=Math.max(s.r,p.x);s.t=Math.min(s.t,p.y);s.b=Math.max(s.b,p.y);}
 const models=groups.map(fit),grid=33,fields=centers.map(()=>new Float32Array(grid*grid*3));let valid=0;
 for(let k=0;k<models.length;k++){await tick(.25+.1*k/models.length);if(!models[k])continue;valid++;for(let y=0;y<grid;y++)for(let x=0;x<grid;x++){const s=supports[k],v=localValue(groups[k],models[k],clamp(x/(grid-1),s.l,s.r),clamp(y/(grid-1),s.t,s.b));for(let c=0;c<3;c++)fields[k][(y*grid+x)*3+c]=clamp(v[c],-40,40);}}
 if(!valid)throw Error('未找到可靠的对应色块，请使用内容相近的图层');
 const out=new Uint8Array(target.data),d=target.data,w=target.width,h=target.height;let changed=0;
 for(let y=0;y<h;y++){if(y%32===0)await tick(.35+.30*y/h);for(let x=0;x<w;x++){const i=(y*w+x)*4;if(!d[i+3])continue;const c=[d[i],d[i+1],d[i+2]],hi=Math.max(...c),lo=Math.min(...c);if(hi<32||lo>238)continue;
 const k=nearest(c,centers);if(!models[k])continue;const dist=Math.sqrt(distance(c,centers[k])),weight=clamp((hi-32)/12,0,1)*clamp((40-dist)/16,0,1);if(!weight)continue;
 let second=-1,secondDistance=Infinity;for(let j=0;j<centers.length;j++){if(j===k||!models[j])continue;const d2=distance(c,centers[j]);if(d2<secondDistance){second=j;secondDistance=d2;}}
 const mix=second<0?0:.5*clamp((12-(Math.sqrt(secondDistance)-dist))/12,0,1);
 const gx=clamp((x-b.l)/b.w,0,1)*(grid-1),gy=clamp((y-b.t)/b.h,0,1)*(grid-1),ix=Math.min(grid-2,Math.floor(gx)),iy=Math.min(grid-2,Math.floor(gy)),fx=gx-ix,fy=gy-iy,f=fields[k];let any=false;
 for(let ch=0;ch<3;ch++){const a=(iy*grid+ix)*3+ch;let delta=correction(fields,k,a,fx,fy,grid);if(mix)delta=delta*(1-mix)+correction(fields,second,a,fx,fy,grid)*mix;out[i+ch]=clamp(Math.round(d[i+ch]+delta*weight),0,255);any=any||out[i+ch]!==d[i+ch];}if(any)changed++;
 }}changed=await smoothCorrection(out,d,w,h,tick);await tick(1);return {data:out,changed,passes:1,analysis:{bounds:b,centers,models,counts:groups.map(g=>g.length)}};
}
return {prepare,synchronize,value};

})();const createHost=(()=>{'use strict';
function createHost(ps,engine,context){
 const {app,imaging,constants,action}=ps;
 function capture(){
  if(!app.documents.length)throw Error('请先打开含有相似图层的文档');const doc=app.activeDocument;
  if(doc.mode!==constants.DocumentMode.RGB||doc.bitsPerChannel!==constants.BitsPerChannelType.EIGHT)throw Error('试用版需要 RGB / 8 位文档');
  const layers=[];
  function collect(items,prefix=''){for(const l of items){if(l.kind===constants.LayerKind.GROUP)collect(l.layers,prefix+l.name+' / ');else if(l.kind===constants.LayerKind.NORMAL&&!l.isBackgroundLayer)layers.push({layer:l,name:prefix+l.name});}}
  collect(doc.layers);
  const active=doc.activeLayers.length===1?doc.activeLayers[0]:null;
  const reference=active&&layers.some(i=>i.layer.id===active.id)?active:null;
  return {doc,reference,layers,historyID:doc.activeHistoryState.id};
 }
 async function validate(layer){
  if(layer.kind!==constants.LayerKind.NORMAL||layer.isBackgroundLayer)throw Error(layer.name+'：请使用普通像素图层（智能对象可先复制并栅格化）');
  const [d]=await action.batchPlay([{_obj:'get',_target:[{_ref:'layer',_id:layer.id}],_options:{dialogOptions:'dontDisplay'}}],{});
  if(!d||d._obj==='error')throw Error('无法检查图层：'+layer.name);
  if(d.group===true||layer.isClippingMask===true)throw Error(layer.name+'：这是剪贴图层，颜色依赖下方图层；当前版请使用未剪贴的像素副本');
  if(d.hasVectorMask||d.layerEffects)throw Error(layer.name+'：暂不处理矢量蒙版或图层效果；普通图层蒙版已支持');
  function percent(raw,fallback){
   if(raw&&typeof raw==='object'&&Number.isFinite(raw._value)&&raw._unit==='percentUnit')return raw._value;
   if(typeof raw==='number'&&raw>=0&&raw<=255)return raw*100/255;
   const n=Number(fallback);if(Number.isFinite(n)&&n>=0&&n<=100)return n;
   throw Error(layer.name+'：无法读取图层不透明度（宿主返回 '+String(raw)+' / '+String(fallback)+'）');
  }
  const opacity=percent(d.opacity,layer.opacity),fill=percent(d.fillOpacity,layer.fillOpacity),mode=d.mode&&d.mode._value||layer.blendMode;
  if(typeof mode!=='string'||!mode)throw Error(layer.name+'：无法读取混合模式');
  return {opacity,fill,mode,hasMask:!!d.hasUserMask,maskEnabled:d.userMaskEnabled!==false};
 }
 async function appearance(layer,values){
  const [result]=await action.batchPlay([{_obj:'set',_target:[{_ref:'layer',_id:layer.id}],to:{_obj:'layer',opacity:{_unit:'percentUnit',_value:values.opacity},fillOpacity:{_unit:'percentUnit',_value:values.fill},mode:{_enum:'blendMode',_value:values.mode}},_options:{dialogOptions:'dontDisplay'}}],{});
  if(result&&result._obj==='error')throw Error(layer.name+'：无法设置读取状态：'+(result.message||result.result));
 }
 async function normalizedRead(doc,layer,settings){
  if(settings.hasMask)return maskedRead(doc,layer,settings);
  if(Math.abs(settings.opacity-100)<.001&&Math.abs(settings.fill-100)<.001&&settings.mode==='normal')return read(doc,layer);
