  const temp=await layer.duplicate();
  try{
   temp.allLocked=false;temp.pixelsLocked=false;temp.transparentPixelsLocked=false;
   await appearance(temp,{opacity:100,fill:100,mode:'normal'});
   await maskEnabled(temp,false);
   const raw=await read(doc,temp);
   if(!settings.maskEnabled)return raw;
   await maskEnabled(temp,true);
   const [r]=await action.batchPlay([{_obj:'delete',_target:[{_ref:'channel',_enum:'channel',_value:'mask'},{_ref:'layer',_id:temp.id}],apply:true,_options:{dialogOptions:'dontDisplay'}}],{});
   if(r&&r._obj==='error')throw Error('无法应用临时蒙版：'+(r.message||r.result));
   const visible=await read(doc,temp);visible.raw=raw;return visible;
  }finally{await temp.delete();}
 }
 function restorePixels(source,result){
  if(!source.raw)return {data:result.data,image:source};
  const raw=source.raw,out=new Uint8Array(raw.data);
  const dx=source.bounds.left-raw.bounds.left,dy=source.bounds.top-raw.bounds.top;
  // Copy colour only. Baking alpha then restoring the mask would apply soft edges twice.
  for(let y=0;y<source.height;y++)for(let x=0;x<source.width;x++){
   const s=(y*source.width+x)*4,rx=x+dx,ry=y+dy;
   if(!source.data[s+3]||rx<0||ry<0||rx>=raw.width||ry>=raw.height)continue;
   const d=(ry*raw.width+rx)*4;for(let c=0;c<3;c++)out[d+c]=result.data[s+c];
  }
  return {data:out,image:raw};
 }
 async function read(doc,layer){
  const b=layer.boundsNoEffects,bounds={left:Math.floor(b.left),top:Math.floor(b.top),right:Math.ceil(b.right),bottom:Math.ceil(b.bottom)};
  if(bounds.right<=bounds.left||bounds.bottom<=bounds.top)throw Error(layer.name+'：图层为空或蒙版完全遮住了图层，没有可用于同步的颜色');
  if((bounds.right-bounds.left)*(bounds.bottom-bounds.top)>20000000)throw Error('单层超过 2000 万像素，试用版暂不处理');
  let response;
  try{response=await imaging.getPixels({documentID:doc.id,layerID:layer.id,sourceBounds:bounds,componentSize:8,applyAlpha:false});const im=response.imageData;
   if(!im||!im.width||!im.height||![3,4].includes(im.components))throw Error('图层没有可读取的 RGB 像素：'+layer.name);
   const raw=await im.getData({chunky:true}),data=new Uint8Array(im.width*im.height*4);
   for(let p=0;p<im.width*im.height;p++){for(let c=0;c<3;c++)data[p*4+c]=raw[p*im.components+c];data[p*4+3]=im.components===4?raw[p*4+3]:255;}
   return {data,width:im.width,height:im.height,bounds:response.sourceBounds,profile:im.colorProfile};
  }finally{if(response&&response.imageData)response.imageData.dispose();}
 }
 async function apply(state,targets,tick){
  if(!state.reference||!state.layers.some(i=>i.layer.id===state.reference.id))throw Error('请选择一个参考图层');
  if(!targets.length)throw Error('请勾选至少一个需要同步的图层');
  if(targets.some(l=>!state.layers.some(i=>i.layer.id===l.id)))throw Error('目标图层不在当前文档列表中');
  if(app.activeDocument.id!==state.doc.id||state.doc.activeHistoryState.id!==state.historyID)throw Error('文档已改变，请关闭工具后重新运行');
  if(targets.some(l=>l.id===state.reference.id)||new Set(targets.map(l=>l.id)).size!==targets.length)throw Error('目标图层不能重复或包含参考图层');
  if(state.doc.selection.bounds)throw Error('请先取消像素选区，再同步完整图层');
  const settings=new Map();for(const l of [state.reference,...targets])settings.set(l.id,await validate(l));
  const suspension=await context.hostControl.suspendHistory({documentID:state.doc.id,name:'统一图层配色与渐变'});let ok=false;const created=[];
  try{
   await tick('读取参考层 '+state.reference.name,0);
   const refImage=await normalizedRead(state.doc,state.reference,settings.get(state.reference.id)),ref=engine.prepare(refImage);refImage.data=null;refImage.raw=null;
   for(let n=0;n<targets.length;n++){
