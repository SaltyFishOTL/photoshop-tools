})();
const ps=require('photoshop'),context=require('uxp').script.executionContext;
const host=createHost(ps,engine,context),state=host.capture();
const dialog=document.createElement('dialog');
dialog.innerHTML="<style>\ndialog{width:860px;height:660px;padding:14px;background:#292929;color:#eee;overflow:hidden;}\nh2{font-size:16px;height:22px;margin:0 0 8px;}\np{font-size:12px;line-height:16px;margin:4px 0;}\nbutton{height:28px;min-height:28px;padding:3px 8px;margin:0 6px 0 0;background:#454545;color:white;font-size:12px;}\n.columns{display:flex;flex-direction:row;height:490px;}\n.column{width:410px;min-width:0;display:flex;flex-direction:column;}\n.left{margin-right:12px;}\n.title{font-size:13px;height:20px;margin:0 0 4px;}\n.search{display:block;width:100%;height:26px;min-height:26px;padding:3px 6px;margin:0 0 6px;background:#383838;color:white;font-size:12px;}\n.list{height:392px;min-height:392px;max-height:392px;overflow:auto;border:1px solid #555;padding:2px;}\nbutton.layer{display:block;width:100%;height:25px;min-height:25px;max-height:25px;padding:2px 5px;margin:0 0 1px;text-align:left;font-size:11px;line-height:19px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\nbutton.selected{background:#315f75;color:#fff;}\n.tools{display:flex;flex-direction:row;margin-top:5px;height:26px;}\n.tools button{height:25px;min-height:25px;font-size:11px;padding:2px 7px;}\n#reference{height:28px;overflow:hidden;font-size:11px;}\n#picked{height:18px;margin:5px 0 3px;}\n#status{height:34px;min-height:34px;margin:2px 0 5px;color:#bde6cf;white-space:pre-wrap;overflow:auto;font-size:11px;line-height:15px;}\n.footer{display:flex;flex-direction:row;justify-content:flex-end;height:29px;}\n</style>\n<h2>相似图层配色统一 · 0.7.1</h2>\n<div class=\"columns\">\n <div class=\"column left\"><p class=\"title\">参考图层 · 单选</p><input type=\"text\" class=\"search\" id=\"refSearch\" placeholder=\"搜索名称 / 图层组\"><div class=\"list\" id=\"refList\"></div><p id=\"reference\"></p></div>\n <div class=\"column\"><p class=\"title\">同步图层 · 多选</p><input type=\"text\" class=\"search\" id=\"targetSearch\" placeholder=\"搜索名称 / 图层组\"><div class=\"list\" id=\"targetList\"></div><div class=\"tools\"><button id=\"selectShown\">选择搜索结果</button><button id=\"clear\">清空选择</button></div></div>\n</div>\n<p id=\"picked\"></p><p id=\"status\">按参考层统一底色、高光与渐变；保留各层线条和表情。结果生成副本。</p>\n<div class=\"footer\"><button id=\"apply\">同步配色</button><button id=\"close\">关闭</button></div>";
document.body.appendChild(dialog);const $=id=>dialog.querySelector('#'+id);
let busy=false,cancelled=false,completed=false;
const refs=[],targets=[],selected=new Set();
function errorText(e){if(e&&e.message)return e.message;if(typeof e==='string')return e;try{return JSON.stringify(e)||String(e);}catch(ignore){return String(e);}}
function status(text){$('status').textContent=text;}
function matches(name,query){return String(name).toLowerCase().includes(String(query||'').trim().toLowerCase());}
function refresh(){
 const id=state.reference?state.reference.id:null;if(id!==null)selected.delete(id);
 for(const v of refs){const active=v.layer.id===id;v.button.textContent=(active?'[参考] ':'[选择] ')+v.label;v.button.className=active?'layer selected':'layer';v.button.disabled=busy||completed;v.button.style.display=matches(v.name,$('refSearch').value)?'block':'none';}
 for(const v of targets){const active=selected.has(v.layer.id),isRef=v.layer.id===id;v.button.textContent=(isRef?'[参考层] ':active?'[已选] ':'[选择] ')+v.label;v.button.className=active?'layer selected':'layer';v.button.disabled=busy||completed||isRef;v.button.style.display=matches(v.name,$('targetSearch').value)?'block':'none';}
 const ref=state.layers.find(i=>i.layer.id===id);$('reference').textContent=ref?'参考：'+ref.name:'尚未选择参考图层';
 const hidden=targets.filter(v=>selected.has(v.layer.id)&&!matches(v.name,$('targetSearch').value)).length;
 $('picked').textContent='已选择 '+selected.size+' 个同步图层'+(hidden?'（其中 '+hidden+' 个在当前搜索结果之外）':'');
 for(const key of ['refSearch','targetSearch','selectShown','clear'])$(key).disabled=busy||completed;
 // Keep Apply clickable before selection: every click must explain what is missing.
 $('apply').disabled=busy||completed;
}
function bind(el,event,fn){el.addEventListener(event,async()=>{try{await fn();}catch(e){busy=false;status('操作失败：'+errorText(e));console.error(e);try{refresh();}catch(ignore){}}});}
for(const item of state.layers){
 const label=item.name+'  [ID '+item.layer.id+']'+(item.layer.visible?'':'（隐藏）');
 for(const isRef of [true,false]){
  const button=document.createElement('button');button.type='button';button.title=label;$(isRef?'refList':'targetList').appendChild(button);
  const entry={button,layer:item.layer,name:item.name,label};(isRef?refs:targets).push(entry);
  bind(button,'click',()=>{if(busy||completed)return;if(isRef){state.reference=item.layer;selected.delete(item.layer.id);status('已设为参考：'+item.name);}else{if(state.reference&&state.reference.id===item.layer.id)return;if(selected.has(item.layer.id))selected.delete(item.layer.id);else selected.add(item.layer.id);status('已选择 '+selected.size+' 个同步图层');}refresh();});
 }
}
bind($('refSearch'),'input',refresh);bind($('targetSearch'),'input',refresh);
bind($('selectShown'),'click',()=>{for(const v of targets)if(!v.button.disabled&&matches(v.name,$('targetSearch').value))selected.add(v.layer.id);refresh();status('已选择 '+selected.size+' 个同步图层');});
bind($('clear'),'click',()=>{selected.clear();refresh();status('已清空同步图层选择');});
if(context.onCancel&&context.onCancel.addListener)context.onCancel.addListener(()=>{cancelled=true;});
bind($('close'),'click',()=>{if(busy){cancelled=true;status('正在取消并回滚…');}else dialog.close();});
bind($('apply'),'click',async()=>{
 if(busy||completed)return;
 if(!state.reference){status('请先在上方点击一个图层，设为参考。');return;}
 const chosen=targets.filter(v=>selected.has(v.layer.id)&&v.layer.id!==state.reference.id).map(v=>v.layer);
 if(!chosen.length){status('请在下方点击至少一个需要同步的图层；选中的行会显示“已选”。');return;}
 try{
  busy=true;cancelled=false;status('已收到操作，正在检查 '+chosen.length+' 个图层…');refresh();$('close').textContent='取消';
  await new Promise(resolve=>setTimeout(resolve,30));
  const created=await host.apply(state,chosen,async(text,p)=>{if(cancelled||context.isCancelled)throw Error('已取消');status(text+' '+Math.round(p*100)+'%');await new Promise(resolve=>setTimeout(resolve,1));if(cancelled||context.isCancelled)throw Error('已取消');});
  completed=true;status('已生成 '+created.length+' 个配色同步副本。关闭窗口，在图层面板分别显示副本查看；原层保留，可一次撤销。');$('apply').textContent='已完成';
 }catch(e){status('未完成：'+errorText(e));console.error(e);}
 finally{busy=false;$('close').textContent='关闭';refresh();}
});
if(!state.layers.length)status('未找到普通像素图层。若图片是智能对象，请先复制并栅格化副本，再运行。');
refresh();try{await dialog.showModal();}finally{dialog.remove();}

})();}catch(e){await require('photoshop').core.showAlert('统一配色：'+(e&&e.message?e.message:String(e)));}
