    const source=await normalizedRead(state.doc,targets[n],settings.get(targets[n].id)),result=await engine.synchronize(ref,source,p=>tick('同步 '+targets[n].name, (n+p)/targets.length));
    const restored=restorePixels(source,result),output=restored.image;
    const visible=targets[n].visible,copy=await targets[n].duplicate();copy.allLocked=false;copy.name=targets[n].name+' · 配色同步';copy.pixelsLocked=false;copy.transparentPixelsLocked=false;
    let im;try{im=await imaging.createImageDataFromBuffer(restored.data,{width:output.width,height:output.height,components:4,colorSpace:'RGB',colorProfile:output.profile});await imaging.putPixels({documentID:state.doc.id,layerID:copy.id,imageData:im,replace:true,targetBounds:{left:output.bounds.left,top:output.bounds.top}});}finally{if(im)im.dispose();}
    copy.visible=visible;targets[n].visible=false;created.push(copy);
   }
   await tick('完成',1);ok=true;
  }finally{await context.hostControl.resumeHistory(suspension,ok);}
  return created;
 }
