  try{await appearance(layer,{opacity:100,fill:100,mode:'normal'});return await read(doc,layer);}
  finally{await appearance(layer,settings);}
 }
 async function maskEnabled(layer,enabled){
  const [r]=await action.batchPlay([{_obj:'set',_target:[{_ref:'layer',_id:layer.id}],to:{_obj:'layer',userMaskEnabled:enabled},_options:{dialogOptions:'dontDisplay'}}],{});
  if(r&&r._obj==='error')throw Error('无法切换临时蒙版：'+(r.message||r.result));
 }
 async function maskedRead(doc,layer,settings){
