// Color Sync 0.6.0 — bounded in-memory colour refinement
try{await(async()=>{const engine=(()=>{'use strict';
// Spatial colour-field matching. Geometry and alpha are never resampled.
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
function distance(a,b){return (a[0]-b[0])**2+(a[1]-b[1])**2+(a[2]-b[2])**2;}
function bounds(im){
 const {data:d,width:w,height:h}=im;let l=w,t=h,r=-1,b=-1;
 for(let y=0;y<h;y+=2)for(let x=0;x<w;x+=2){const i=(y*w+x)*4;if(d[i+3]<200||Math.min(d[i],d[i+1],d[i+2])>240)continue;l=Math.min(l,x);r=Math.max(r,x);t=Math.min(t,y);b=Math.max(b,y);}
 if(r-l<8||b-t<8)throw Error('没有足够的人物像素');return {l,t,w:r-l+1,h:b-t+1};
}
function samples(im,b){
 const out=[],{width:w,height:h,data:d}=im,step=Math.max(2,Math.ceil(Math.sqrt(w*h/80000)));
 for(let y=2;y<h-2;y+=step)for(let x=2;x<w-2;x+=step){
  const i=(y*w+x)*4,c=[d[i],d[i+1],d[i+2]],hi=Math.max(...c),lo=Math.min(...c);
  if(d[i+3]<250||hi<38||lo>238||hi-lo<9)continue;
  let edge=0;for(const j of [i-4,i+4,i-w*4,i+w*4])for(let k=0;k<3;k++)edge=Math.max(edge,Math.abs(d[i+k]-d[j+k]));
  if(edge>10)continue;
  out.push({c,x:clamp((x-b.l)/b.w,0,1),y:clamp((y-b.t)/b.h,0,1)});
 }return out;
}
function palette(points){
 const bins=new Map();for(const p of points){const key=p.c.map(x=>x>>4).join(',');let b=bins.get(key);if(!b){b={n:0,c:[0,0,0]};bins.set(key,b);}b.n++;for(let k=0;k<3;k++)b.c[k]+=p.c[k];}
 const ranked=[...bins.values()].sort((a,b)=>b.n-a.n),centers=[];
 for(const b of ranked){const c=b.c.map(x=>x/b.n);if(centers.every(v=>distance(c,v)>26*26)){centers.push(c);if(centers.length===8)break;}}
 for(let it=0;it<6;it++){const sums=centers.map(()=>[0,0,0,0]);for(const p of points){const j=nearest(p.c,centers);if(distance(p.c,centers[j])>65*65)continue;const s=sums[j];s[3]++;for(let k=0;k<3;k++)s[k]+=p.c[k];}for(let j=0;j<centers.length;j++)if(sums[j][3])centers[j]=sums[j].slice(0,3).map(x=>x/sums[j][3]);}
 return centers;
}
function nearest(c,p){let j=0,best=Infinity;for(let k=0;k<p.length;k++){const d=distance(c,p[k]);if(d<best){best=d;j=k;}}return j;}
// Quadratic low-frequency field; robust fitting rejects remaining detail pixels.
function basis(x,y){return [1,x,y,x*x,x*y,y*y];}
function solve(a,b){const n=b.length,m=a.map((r,i)=>[...r,b[i]]);for(let i=0;i<n;i++){let p=i;for(let j=i+1;j<n;j++)if(Math.abs(m[j][i])>Math.abs(m[p][i]))p=j;[m[i],m[p]]=[m[p],m[i]];if(Math.abs(m[i][i])<1e-10)return null;const v=m[i][i];for(let k=i;k<=n;k++)m[i][k]/=v;for(let j=0;j<n;j++)if(j!==i){const f=m[j][i];for(let k=i;k<=n;k++)m[j][k]-=f*m[i][k];}}return m.map(r=>r[n]);}
function value(model,x,y){const f=basis(x,y);return model.map(a=>a.reduce((s,v,k)=>s+v*f[k],0));}
function fit(points){
 if(points.length<30)return null;let model;
 for(let pass=0;pass<3;pass++){
  const a=Array.from({length:6},()=>Array(6).fill(0)),v=Array.from({length:3},()=>Array(6).fill(0));
  for(const p of points){let weight=1;if(model){const residual=Math.sqrt(distance(p.c,value(model,p.x,p.y)));weight=Math.min(1,6/Math.max(1,residual));}const f=basis(p.x,p.y);for(let i=0;i<6;i++){for(let j=0;j<6;j++)a[i][j]+=weight*f[i]*f[j];for(let k=0;k<3;k++)v[k][i]+=weight*f[i]*p.c[k];}}
  // Damping only curvature, not the constant or linear gradient.
  for(let i=0;i<6;i++)a[i][i]+=i<3?1e-7:points.length*0.0001;
  model=v.map(c=>solve(a,c));if(model.some(x=>!x))return null;
 }return model;
}
function analyze(im,centers){const b=bounds(im),pts=samples(im,b);if(pts.length<100)throw Error('可匹配的平滑色块不足');const p=centers||palette(pts);const groups=p.map(()=>[]);for(const s of pts){const k=nearest(s.c,p);if(distance(s.c,p[k])<48*48)groups[k].push(s);}return {bounds:b,centers:p,models:groups.map(fit),counts:groups.map(g=>g.length)};}
function prepare(ref){return analyze(ref);}
function field(reference,target){
 const t=analyze(target,reference.centers),b=t.bounds,grid=33,fields=reference.centers.map(()=>new Float32Array(grid*grid*3));let valid=0;
 for(let k=0;k<fields.length;k++){
  if(!reference.models[k]||!t.models[k])continue;valid++;
  for(let y=0;y<grid;y++)for(let x=0;x<grid;x++){const u=x/(grid-1),v=y/(grid-1),r=value(reference.models[k],u,v),s=value(t.models[k],u,v);for(let c=0;c<3;c++)fields[k][(y*grid+x)*3+c]=clamp(r[c]-s[c],-24,24);}
 }
 if(valid<1)throw Error('没有匹配到共同色块');return {target:t,bounds:b,grid,fields,reference};
}
function rows(im,f,out,y0,y1){
 const {data:d,width:w}=im,{bounds:b,grid:g,fields,reference}=f;let changed=0;
 for(let y=y0;y<y1;y++)for(let x=0;x<w;x++){
  const i=(y*w+x)*4;if(d[i+3]===0)continue;const c=[d[i],d[i+1],d[i+2]],hi=Math.max(...c),lo=Math.min(...c);
  if(hi<32||lo>238||hi-lo<6)continue;
  const k=nearest(c,reference.centers);if(!reference.models[k]||!f.target.models[k])continue;
  const dist=Math.sqrt(distance(c,reference.centers[k]));
  // Freeze black ink; taper uncertain colours instead of recolouring distinct details.
  const weight=clamp((hi-32)/20,0,1)*clamp((56-dist)/18,0,1)*clamp((hi-lo-6)/8,0,1);if(!weight)continue;
  const gx=clamp((x-b.l)/b.w,0,1)*(g-1),gy=clamp((y-b.t)/b.h,0,1)*(g-1),ix=Math.min(g-2,Math.floor(gx)),iy=Math.min(g-2,Math.floor(gy)),fx=gx-ix,fy=gy-iy,field=fields[k];let any=false;
  for(let ch=0;ch<3;ch++){const a=(iy*g+ix)*3+ch;const delta=(field[a]*(1-fx)+field[a+3]*fx)*(1-fy)+(field[a+g*3]*(1-fx)+field[a+g*3+3]*fx)*fy;out[i+ch]=clamp(Math.round(d[i+ch]+delta*weight),0,255);any=any||out[i+ch]!==d[i+ch];}if(any)changed++;
 }return changed;
}
async function synchronize(reference,target,tick=async()=>{}){
 // Refine in memory, using the same guarded step as repeated manual runs.
 // Never accumulate baked mask alpha or reread/rewrite Photoshop layers between rounds.
 let current=target,analysis,passes=0;const maxPasses=3;
 for(let pass=0;pass<maxPasses;pass++){
  const f=field(reference,current),out=new Uint8Array(current.data);let changed=0;
  for(let y=0;y<target.height;y+=32){await tick((pass+y/target.height)/maxPasses);changed+=rows(current,f,out,y,Math.min(target.height,y+32));}
  analysis=f.target;passes++;
  current={...target,data:out};
  // Exact pixel stability is safer than a global mean: small colour regions still matter.
  if(!changed)break;
 }
 let changed=0;for(let i=0;i<target.data.length;i+=4)if(current.data[i]!==target.data[i]||current.data[i+1]!==target.data[i+1]||current.data[i+2]!==target.data[i+2])changed++;
 await tick(1);return {data:current.data,changed,analysis,passes};
}
return {prepare,synchronize,analyze,value};
})();const createHost=(()=>{'use strict';
function createHost(ps,engine,context){
 const {app,imaging,constants,action}=ps;
 function capture(){
  if(!app.documents.length)throw Error('请先打开含有相似图层的文档');const doc=app.activeDocument;
  if(doc.mode!==constants.DocumentMode.RGB||doc.bitsPerChannel!==constants.BitsPerChannelType.EIGHT)throw Error('试用版需要 RGB / 8 位文档');
  const layers=[];
  function collect(items,prefix=''){for(const l of items){if(l.kind===constants.LayerKind.GROUP)collect(l.layers,prefix+l.name+' / ');else if(l.kind===constants.LayerKind.NORMAL&&!l.isBackgroundLayer)layers.push({layer:l,name:prefix+l.name});}}
  collect(doc.layers);
  const active=doc.activeLayers.length===1?doc.activeLayers[0]:null;
  const reference=active&&layers.some(i=>i.layer.id===active.id)?active:null;
  return {doc,reference,layers,historyID:doc.activeHistoryState.id};
 }
 async function validate(layer){
  if(layer.kind!==constants.LayerKind.NORMAL||layer.isBackgroundLayer)throw Error(layer.name+'：请使用普通像素图层（智能对象可先复制并栅格化）');
  const [d]=await action.batchPlay([{_obj:'get',_target:[{_ref:'layer',_id:layer.id}],_options:{dialogOptions:'dontDisplay'}}],{});
  if(!d||d._obj==='error')throw Error('无法检查图层：'+layer.name);
  if(d.group===true||layer.isClippingMask===true)throw Error(layer.name+'：这是剪贴图层，颜色依赖下方图层；当前版请使用未剪贴的像素副本');
  if(d.hasVectorMask||d.layerEffects)throw Error(layer.name+'：暂不处理矢量蒙版或图层效果；普通图层蒙版已支持');
  function percent(raw,fallback){
   if(raw&&typeof raw==='object'&&Number.isFinite(raw._value)&&raw._unit==='percentUnit')return raw._value;
   if(typeof raw==='number'&&raw>=0&&raw<=255)return raw*100/255;
   const n=Number(fallback);if(Number.isFinite(n)&&n>=0&&n<=100)return n;
   throw Error(layer.name+'：无法读取图层不透明度（宿主返回 '+String(raw)+' / '+String(fallback)+'）');
  }
  const opacity=percent(d.opacity,layer.opacity),fill=percent(d.fillOpacity,layer.fillOpacity),mode=d.mode&&d.mode._value||layer.blendMode;
  if(typeof mode!=='string'||!mode)throw Error(layer.name+'：无法读取混合模式');
  return {opacity,fill,mode,hasMask:!!d.hasUserMask,maskEnabled:d.userMaskEnabled!==false};
 }
 async function appearance(layer,values){
  const [result]=await action.batchPlay([{_obj:'set',_target:[{_ref:'layer',_id:layer.id}],to:{_obj:'layer',opacity:{_unit:'percentUnit',_value:values.opacity},fillOpacity:{_unit:'percentUnit',_value:values.fill},mode:{_enum:'blendMode',_value:values.mode}},_options:{dialogOptions:'dontDisplay'}}],{});
  if(result&&result._obj==='error')throw Error(layer.name+'：无法设置读取状态：'+(result.message||result.result));
 }
 async function normalizedRead(doc,layer,settings){
  if(settings.hasMask)return maskedRead(doc,layer,settings);
  if(Math.abs(settings.opacity-100)<.001&&Math.abs(settings.fill-100)<.001&&settings.mode==='normal')return read(doc,layer);
  // Change only appearance inside the history transaction, then restore even on failure.
  try{await appearance(layer,{opacity:100,fill:100,mode:'normal'});return await read(doc,layer);}
  finally{await appearance(layer,settings);}
 }
 async function maskEnabled(layer,enabled){
  const [r]=await action.batchPlay([{_obj:'set',_target:[{_ref:'layer',_id:layer.id}],to:{_obj:'layer',userMaskEnabled:enabled},_options:{dialogOptions:'dontDisplay'}}],{});
  if(r&&r._obj==='error')throw Error('无法切换临时蒙版：'+(r.message||r.result));
 }
 async function maskedRead(doc,layer,settings){
  // Bake only a disposable duplicate. Keep original pixels and the editable mask untouched.
  const temp=await layer.duplicate();
  try{
   temp.allLocked=false;temp.pixelsLocked=false;temp.transparentPixelsLocked=false;
   await appearance(temp,{opacity:100,fill:100,mode:'normal'});
   await maskEnabled(temp,false);
   const raw=await read(doc,temp);
   if(!settings.maskEnabled)return raw;
   await maskEnabled(temp,true);
   const [r]=await action.batchPlay([{_obj:'delete',_target:[{_ref:'channel',_enum:'channel',_value:'mask'},{_ref:'layer',_id:temp.id}],apply:true,_options:{dialogOptions:'dontDisplay'}}],{});
   if(r&&r._obj==='error')throw Error('无法应用临时蒙版：'+(r.message||r.result));
   const visible=await read(doc,temp);visible.raw=raw;return visible;
  }finally{await temp.delete();}
 }
 function restorePixels(source,result){
  if(!source.raw)return {data:result.data,image:source};
  const raw=source.raw,out=new Uint8Array(raw.data);
  const dx=source.bounds.left-raw.bounds.left,dy=source.bounds.top-raw.bounds.top;
  // Copy colour only. Baking alpha then restoring the mask would apply soft edges twice.
  for(let y=0;y<source.height;y++)for(let x=0;x<source.width;x++){
   const s=(y*source.width+x)*4,rx=x+dx,ry=y+dy;
   if(!source.data[s+3]||rx<0||ry<0||rx>=raw.width||ry>=raw.height)continue;
   const d=(ry*raw.width+rx)*4;for(let c=0;c<3;c++)out[d+c]=result.data[s+c];
  }
  return {data:out,image:raw};
 }
 async function read(doc,layer){
  const b=layer.boundsNoEffects,bounds={left:Math.floor(b.left),top:Math.floor(b.top),right:Math.ceil(b.right),bottom:Math.ceil(b.bottom)};
  if(bounds.right<=bounds.left||bounds.bottom<=bounds.top)throw Error(layer.name+'：图层为空或蒙版完全遮住了图层，没有可用于同步的颜色');
  if((bounds.right-bounds.left)*(bounds.bottom-bounds.top)>20000000)throw Error('单层超过 2000 万像素，试用版暂不处理');
  let response;
  try{response=await imaging.getPixels({documentID:doc.id,layerID:layer.id,sourceBounds:bounds,componentSize:8,applyAlpha:false});const im=response.imageData;
   if(!im||!im.width||!im.height||![3,4].includes(im.components))throw Error('图层没有可读取的 RGB 像素：'+layer.name);
   const raw=await im.getData({chunky:true}),data=new Uint8Array(im.width*im.height*4);
   for(let p=0;p<im.width*im.height;p++){for(let c=0;c<3;c++)data[p*4+c]=raw[p*im.components+c];data[p*4+3]=im.components===4?raw[p*4+3]:255;}
   return {data,width:im.width,height:im.height,bounds:response.sourceBounds,profile:im.colorProfile};
  }finally{if(response&&response.imageData)response.imageData.dispose();}
 }
 async function apply(state,targets,tick){
  if(!state.reference||!state.layers.some(i=>i.layer.id===state.reference.id))throw Error('请选择一个参考图层');
  if(!targets.length)throw Error('请勾选至少一个需要同步的图层');
  if(targets.some(l=>!state.layers.some(i=>i.layer.id===l.id)))throw Error('目标图层不在当前文档列表中');
  if(app.activeDocument.id!==state.doc.id||state.doc.activeHistoryState.id!==state.historyID)throw Error('文档已改变，请关闭工具后重新运行');
  if(targets.some(l=>l.id===state.reference.id)||new Set(targets.map(l=>l.id)).size!==targets.length)throw Error('目标图层不能重复或包含参考图层');
  if(state.doc.selection.bounds)throw Error('请先取消像素选区，再同步完整图层');
  const settings=new Map();for(const l of [state.reference,...targets])settings.set(l.id,await validate(l));
  const suspension=await context.hostControl.suspendHistory({documentID:state.doc.id,name:'统一图层配色与渐变'});let ok=false;const created=[];
  try{
   await tick('读取参考层 '+state.reference.name,0);
   const refImage=await normalizedRead(state.doc,state.reference,settings.get(state.reference.id)),ref=engine.prepare(refImage);refImage.data=null;refImage.raw=null;
   for(let n=0;n<targets.length;n++){
    await tick('读取 '+targets[n].name,n/targets.length);
    const source=await normalizedRead(state.doc,targets[n],settings.get(targets[n].id)),result=await engine.synchronize(ref,source,p=>tick('同步 '+targets[n].name, (n+p)/targets.length));
    const restored=restorePixels(source,result),output=restored.image;
    const visible=targets[n].visible,copy=await targets[n].duplicate();copy.allLocked=false;copy.name=targets[n].name+' · 配色同步';copy.pixelsLocked=false;copy.transparentPixelsLocked=false;
    let im;try{im=await imaging.createImageDataFromBuffer(restored.data,{width:output.width,height:output.height,components:4,colorSpace:'RGB',colorProfile:output.profile});await imaging.putPixels({documentID:state.doc.id,layerID:copy.id,imageData:im,replace:true,targetBounds:{left:output.bounds.left,top:output.bounds.top}});}finally{if(im)im.dispose();}
    copy.visible=visible;targets[n].visible=false;created.push(copy);
   }
   await tick('完成',1);ok=true;
  }finally{await context.hostControl.resumeHistory(suspension,ok);}
  return created;
 }
